# Copy to .env and adjust. .env is not committed.
AIRDESK_READSB_URL=http://192.168.1.20/tar1090
# Optional: where your ADS-B antenna is, for distances and the map's starting point
#AIRDESK_RECEIVER_LAT=
#AIRDESK_RECEIVER_LON=
